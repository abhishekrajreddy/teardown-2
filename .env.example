# Postgres — Supabase gives you TWO strings, and Prisma needs both:
# 1. DATABASE_URL: the pooled connection (port 6543) — the running app uses this
# 2. DIRECT_URL: the direct connection (port 5432) — `prisma migrate` uses this
#
# Get both from: Supabase dashboard → your project → "Connect" button (top right)
# → ORM tab → select "Prisma" → copy each string shown.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Seed script (used once, then change your password in the app)
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="changeme123"

# Google sign-in (optional — omit both and only email/password login shows).
# Get these from https://console.cloud.google.com/apis/credentials
# 1. Create a project (or use an existing one)
# 2. "Configure consent screen" → External → fill in app name/email → publish to "Testing" and add your friends' Google emails as test users (no Google review needed for testing)
# 3. "Create credentials" → OAuth client ID → Web application
# 4. Authorized redirect URI: http://localhost:3000/api/auth/callback/google (add your production URL too once deployed, e.g. https://your-app.vercel.app/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
